        </div>
      </div>
    </div>`;
}

function toggleFav(id,el){
  if(S.favs.includes(id)){ S.favs=S.favs.filter(x=>x!==id); el.classList.remove('on'); el.textContent='♡'; }
  else { S.favs.push(id); el.classList.add('on'); el.textContent='♥'; }
  save('favs',S.favs);
}

