function prodCard(p, showHit=false){
  const sale=p.sale ? Math.round(p.price*(1-p.sale/100)) : p.price;
  const isFav=S.favs.includes(p.id);
  return `
    <div class="prod-card" onclick="openProd(${p.id})">
      <div class="prod-img-box">
        <img src="${p.img}" alt="${p.brand} ${p.model}" loading="lazy"
             onerror="this.onerror=null;this.src='${fallback(p)}'">
        <div class="prod-badges">
          ${p.isNew?'<span class="badge badge-new">Новинка</span>':''}
          ${p.sale?`<span class="badge badge-sale">−${p.sale}%</span>`:''}
          ${(showHit||p.reviews>100)?'<span class="badge badge-hit">🔥 Хит</span>':''}
        </div>
        <div class="prod-fav${isFav?' on':''}" onclick="event.stopPropagation();toggleFav(${p.id},this)">${isFav?'♥':'♡'}</div>
      </div>
      <div class="prod-body">
        <div class="prod-brand">${p.brand}</div>
        <div class="prod-name">${p.model}</div>
        ${p.color?`<div class="prod-meta">Цвет: ${p.color}</div>`:''}
        ${p.ram>0?`<div class="prod-meta">${p.ram} ГБ RAM · ${p.storage} ГБ</div>`:''}
        <div class="prod-stars">${stars(p.rating)}<span>${p.rating} (${p.reviews})</span></div>
        <div class="prod-foot">
          <div>
            <div class="prod-price">${fmt(sale)}</div>
            ${p.sale?`<div class="prod-price-old">${fmt(p.price)}</div>`:''}
          </div>
