<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Loamanho Store — Смартфоны в Назрани</title>
<meta name="description" content="Loamanho Store — Samsung, Xiaomi, iPhone в Назрани. Бронируй онлайн, забирай через час, оплата в магазине.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh;transition:background .22s,color .22s;overflow-x:hidden}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer;border:none;background:none;outline:none}
img{display:block;max-width:100%}
input,textarea,select{font-family:inherit;outline:none}
:root{
  --bg:#f5f5f7;--bg2:#ffffff;--bg3:#f0f0f5;--bg4:#e8e8ed;
  --surface:#ffffff;--border:#d2d2d7;--border2:#e5e5ea;
  --shadow:0 2px 16px rgba(0,0,0,.06);--shadow-lg:0 8px 40px rgba(0,0,0,.11);
  --text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;
  --blue:#0071e3;--btn:#1d1d1f;--btn-t:#fff;
  --green:#1a8a3e;--green-bg:rgba(26,138,62,.08);--green-bd:rgba(26,138,62,.2);
  --wa:#25d366;--r:14px;--r-sm:10px;
}
[data-theme=dark]{
  --bg:#111113;--bg2:#1c1c1e;--bg3:#2c2c2e;--bg4:#3a3a3c;
  --surface:#1c1c1e;--border:#3a3a3c;--border2:#48484a;
  --shadow:0 2px 20px rgba(0,0,0,.4);--shadow-lg:0 8px 40px rgba(0,0,0,.55);
  --text:#f5f5f7;--text2:#aeaeb2;--text3:#636366;
  --blue:#1a84ff;--btn:#f5f5f7;--btn-t:#000;
  --green:#30d158;--green-bg:rgba(48,209,88,.09);--green-bd:rgba(48,209,88,.25);
}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* ── NAV ── */
.nav{position:sticky;top:0;z-index:200;height:54px;display:flex;align-items:center;padding:0 24px;gap:14px;border-bottom:1px solid var(--border)}
[data-theme=light] .nav{background:rgba(255,255,255,.92);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}
[data-theme=dark]  .nav{background:rgba(17,17,19,.92);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}
.nav-logo{font-size:17px;font-weight:800;letter-spacing:-.5px;cursor:pointer;white-space:nowrap}
.nav-logo em{font-style:normal;color:var(--blue)}
.nav-links{display:flex;gap:2px;flex:1}
.nl{padding:5px 11px;border-radius:8px;font-size:13px;font-weight:500;color:var(--text2);cursor:pointer;transition:.16s;white-space:nowrap}
.nl:hover,.nl.on{color:var(--text);background:var(--bg3)}
.nav-search{position:relative;max-width:280px;flex:1}
.nav-search input{width:100%;padding:7px 13px 7px 32px;background:var(--bg3);border:1px solid var(--border);border-radius:20px;font-size:13px;color:var(--text);transition:.18s}
.nav-search input:focus{border-color:var(--blue);background:var(--bg2);box-shadow:0 0 0 3px rgba(0,113,227,.08)}
.nav-search .sico{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;pointer-events:none;color:var(--text3)}
.nav-r{display:flex;align-items:center;gap:6px;margin-left:auto}
.nav-ico{width:35px;height:35px;border-radius:9px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:15px;transition:.16s;position:relative;cursor:pointer}
.nav-ico:hover{border-color:var(--blue);color:var(--blue)}
.nav-badge{position:absolute;top:-4px;right:-4px;background:var(--blue);color:#fff;font-size:9px;font-weight:700;width:15px;height:15px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--bg2)}
.theme-pill{padding:5px 11px;border-radius:20px;background:var(--bg3);border:1px solid var(--border);font-size:12px;font-weight:500;color:var(--text2);cursor:pointer;transition:.16s;white-space:nowrap}
.theme-pill:hover{border-color:var(--blue);color:var(--blue)}
.sdrop{position:absolute;top:calc(100%+4px);left:0;right:0;background:var(--bg2);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:300;overflow:hidden;display:none}
.sdrop.open{display:block}
.sdrop-item{display:flex;align-items:center;gap:10px;padding:9px 13px;cursor:pointer;border-bottom:1px solid var(--border2);transition:.14s}
.sdrop-item:last-child{border-bottom:none}
.sdrop-item:hover{background:var(--bg3)}
.sdrop-item img{width:36px;height:36px;object-fit:contain;background:#fff;border-radius:7px;padding:2px;flex-shrink:0}
.sdrop-name{font-size:13px;font-weight:500;color:var(--text)}
.sdrop-price{font-size:12px;color:var(--blue);font-weight:600;margin-top:1px}

/* ── PAGES ── */
.page{display:none}
.page.active{display:block}
.cnt{max-width:1200px;margin:0 auto;padding:0 24px}
.sec{padding:48px 0}
.shd{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.stit{font-size:20px;font-weight:700;letter-spacing:-.3px}
.stit em{font-style:normal;color:var(--blue)}
.see-all{font-size:13px;color:var(--blue);font-weight:500;cursor:pointer}
.see-all:hover{text-decoration:underline}

/* ── HERO ── */
.hero{background:var(--bg2);border-bottom:1px solid var(--border);padding:48px 24px 40px}
.hero-in{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:48px;align-items:center}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);color:var(--text2);padding:4px 12px;border-radius:100px;font-size:11px;font-weight:500;margin-bottom:14px}
.hero h1{font-size:clamp(28px,4vw,48px);font-weight:800;line-height:1.1;letter-spacing:-.8px;margin-bottom:12px}
.hero h1 em{font-style:normal;color:var(--blue)}
.hero-sub{color:var(--text2);font-size:15px;margin-bottom:24px;line-height:1.65;max-width:400px}
.hero-btns{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:28px}
.hero-stats{display:flex;gap:28px;padding-top:22px;border-top:1px solid var(--border)}
.hs-n{font-size:22px;font-weight:800}
.hs-l{font-size:11px;color:var(--text3);margin-top:1px}
.hero-img{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hprod{background:var(--bg3);border:1.5px solid var(--border);border-radius:12px;padding:10px;cursor:pointer;transition:.2s;text-align:center}
.hprod:hover{border-color:var(--blue);transform:translateY(-2px);box-shadow:var(--shadow)}
.hprod img{width:68px;height:68px;object-fit:contain;margin:0 auto 6px;background:#fff;border-radius:7px;padding:3px}
.hprod .hp-brand{font-size:10px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.hprod .hp-name{font-size:11px;font-weight:600;color:var(--text);line-height:1.3;margin:2px 0}
.hprod .hp-price{font-size:12px;font-weight:700;color:var(--blue)}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:100px;font-size:14px;font-weight:600;cursor:pointer;transition:.18s;font-family:inherit;border:none}
.btn-sm{padding:7px 14px;font-size:12px}
.btn-primary{background:var(--btn);color:var(--btn-t)}
.btn-primary:hover{opacity:.82;transform:translateY(-1px)}
.btn-outline{background:transparent;color:var(--text);border:1.5px solid var(--border)}
.btn-outline:hover{border-color:var(--text);background:var(--bg3)}
.btn-green{background:var(--wa);color:#fff}
.btn-green:hover{opacity:.88}
.btn-blue{background:var(--blue);color:#fff}
.btn-blue:hover{opacity:.88;transform:translateY(-1px)}
.btn-full{width:100%;justify-content:center}

/* ── INFO STRIP ── */
.info-strip{background:var(--bg2);border-bottom:1px solid var(--border);padding:9px 24px}
.info-strip-in{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center}
.info-strip a,.info-strip span{font-size:13px;color:var(--text2);display:flex;align-items:center;gap:5px;white-space:nowrap}
.info-strip a:hover{color:var(--blue)}

/* ── BRAND CHIPS ── */
.brand-bar{background:var(--bg2);border-bottom:1px solid var(--border);padding:10px 0;overflow:hidden}
.brand-scroll{display:flex;gap:6px;max-width:1200px;margin:0 auto;padding:0 24px;overflow-x:auto;scrollbar-width:none}
.brand-scroll::-webkit-scrollbar{display:none}
.bchip{padding:5px 13px;border:1.5px solid var(--border);border-radius:100px;font-size:12px;font-weight:500;color:var(--text2);cursor:pointer;white-space:nowrap;transition:.16s;flex-shrink:0}
.bchip:hover,.bchip.on{border-color:var(--blue);color:var(--blue);background:rgba(0,113,227,.05)}

/* ── CATS ── */
.cats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.cat-card{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:18px 14px;text-align:center;cursor:pointer;transition:.2s}
.cat-card:hover{border-color:var(--blue);transform:translateY(-3px);box-shadow:var(--shadow)}
.cat-icon{font-size:28px;margin-bottom:8px}
.cat-name{font-weight:600;font-size:14px}
.cat-cnt{font-size:11px;color:var(--text3);margin-top:2px}

/* ── BANNERS ── */
.banners{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.banner{border-radius:var(--r);padding:24px;cursor:pointer;transition:.2s;position:relative;overflow:hidden}
.banner:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.bn1{background:linear-gradient(135deg,#0071e3,#004db3)}
.bn2{background:linear-gradient(135deg,#1d1d1f,#3d3d3f)}
[data-theme=dark] .bn1{background:linear-gradient(135deg,#004db3,#00338a)}
.banner h3{font-size:17px;font-weight:700;color:#fff;margin-bottom:5px}
.banner p{font-size:13px;color:rgba(255,255,255,.7);margin-bottom:12px}
.banner-deco{position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:56px;opacity:.12;pointer-events:none}

/* ── HOW IT WORKS ── */
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.how-card{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:20px;text-align:center}
.how-num{width:36px;height:36px;border-radius:50%;background:var(--blue);color:#fff;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.how-title{font-size:14px;font-weight:600;margin-bottom:6px}
.how-desc{font-size:13px;color:var(--text2);line-height:1.5}

/* ── PRODUCT GRID ── */
.prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:13px}

/* ── PRODUCT CARD ── */
.prod-card{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);overflow:hidden;cursor:pointer;transition:.2s;display:flex;flex-direction:column;position:relative}
.prod-card:hover{border-color:rgba(0,113,227,.4);transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.prod-img-box{background:#fff;display:flex;align-items:center;justify-content:center;height:185px;padding:12px;position:relative;flex-shrink:0;border-bottom:1px solid var(--border2)}
.prod-img-box img{max-height:155px;max-width:100%;object-fit:contain;width:auto;height:auto;transition:transform .3s;display:block}
.prod-card:hover .prod-img-box img{transform:scale(1.04)}
.prod-badges{position:absolute;top:8px;left:8px;display:flex;flex-direction:column;gap:3px;z-index:2}
.badge{display:inline-block;padding:2px 7px;border-radius:100px;font-size:10px;font-weight:700}
.badge-new{background:rgba(0,113,227,.1);color:var(--blue);border:1px solid rgba(0,113,227,.2)}
.badge-hit{background:rgba(255,59,48,.1);color:#d62a1f;border:1px solid rgba(255,59,48,.2)}
.badge-sale{background:rgba(255,149,0,.1);color:#b06000;border:1px solid rgba(255,149,0,.2)}
.prod-fav{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:7px;background:rgba(255,255,255,.9);border:1px solid var(--border);color:var(--text3);font-size:13px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.16s;z-index:2}
[data-theme=dark] .prod-fav{background:rgba(28,28,30,.88)}
.prod-fav:hover,.prod-fav.on{color:#e0374b;border-color:rgba(224,55,75,.3)}
.prod-body{padding:11px 13px 13px;flex:1;display:flex;flex-direction:column}
.prod-brand{font-size:10px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.prod-name{font-size:13px;font-weight:600;color:var(--text);line-height:1.35;flex:1;margin-bottom:2px}
.prod-meta{font-size:11px;color:var(--text3);margin-bottom:6px}
.prod-stars{font-size:11px;color:#f59e0b;margin-bottom:8px}
.prod-stars span{color:var(--text3);font-size:10px;margin-left:3px}
.prod-foot{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-top:auto}
.prod-price{font-size:16px;font-weight:800;color:var(--text)}
.prod-price-old{font-size:11px;color:var(--text3);text-decoration:line-through}
.add-btn{width:32px;height:32px;border-radius:8px;background:var(--btn);color:var(--btn-t);font-size:18px;display:flex;align-items:center;justify-content:center;transition:.16s;flex-shrink:0;font-weight:300;line-height:1}
.add-btn:hover{opacity:.78;transform:scale(1.08)}

/* ── CATALOG ── */
.cat-wrap{display:grid;grid-template-columns:220px 1fr;gap:20px;max-width:1200px;margin:0 auto;padding:26px 24px}
.sidebar{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;height:fit-content;position:sticky;top:66px}
.sb-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.sb-title{font-size:14px;font-weight:700}
.sb-clear{font-size:12px;color:var(--blue);cursor:pointer}
.sb-clear:hover{text-decoration:underline}
.fsec{margin-bottom:18px}
.fsec h4{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{padding:4px 10px;border:1.5px solid var(--border);border-radius:100px;font-size:11px;font-weight:500;color:var(--text2);cursor:pointer;transition:.14s}
.chip:hover{border-color:var(--blue);color:var(--blue)}
.chip.on{background:rgba(0,113,227,.07);border-color:var(--blue);color:var(--blue)}
.price-row{display:flex;gap:6px;align-items:center}
.price-inp{width:100%;padding:6px 9px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--r-sm);font-size:12px;color:var(--text);transition:.16s}
.price-inp:focus{border-color:var(--blue)}
.sort-row{display:flex;align-items:center;gap:9px;margin-bottom:14px;flex-wrap:wrap}
.sort-sel{padding:7px 11px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:13px;color:var(--text);cursor:pointer}
.sort-sel:focus{border-color:var(--blue)}
.res-n{font-size:13px;color:var(--text3);margin-left:auto}

/* ── PRODUCT MODAL ── */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.48);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:400;display:flex;align-items:center;justify-content:center;padding:14px;opacity:0;pointer-events:none;transition:.22s}
.overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--bg2);border-radius:18px;width:100%;max-width:800px;max-height:90vh;overflow-y:auto;position:relative;transform:translateY(12px);transition:.22s}
.overlay.open .modal{transform:translateY(0)}
.mclose{position:absolute;top:12px;right:12px;width:28px;height:28px;border-radius:7px;background:var(--bg3);color:var(--text2);font-size:14px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:10;transition:.15s}
.mclose:hover{background:var(--border);color:var(--text)}
.ppg{display:grid;grid-template-columns:1fr 1fr}
.pgall{background:#fff;display:flex;align-items:center;justify-content:center;padding:32px 24px;min-height:300px;border-radius:18px 0 0 0}
.pgall img{max-height:260px;max-width:100%;object-fit:contain;width:auto;height:auto}
.pinfo{padding:26px 24px;display:flex;flex-direction:column}
.pib{font-size:10px;color:var(--blue);font-weight:700;text-transform:uppercase;letter-spacing:.7px;margin-bottom:4px}
.pin{font-size:19px;font-weight:700;letter-spacing:-.3px;margin-bottom:4px;line-height:1.25}
.psr{display:flex;align-items:center;gap:5px;margin-bottom:10px;font-size:12px}
.pprice{font-size:28px;font-weight:800;margin-bottom:4px;letter-spacing:-.5px}
.pclr{font-size:12px;color:var(--text2);margin-bottom:14px}
.spec-t{width:100%;font-size:12px;margin-bottom:16px}
.spec-t tr:not(:last-child) td{padding-bottom:8px}
.spec-t .sl{color:var(--text3);width:100px}
.spec-t .sv{color:var(--text);font-weight:500}
.pickup-box{background:var(--bg3);border-radius:var(--r-sm);padding:11px 13px;margin-bottom:10px}
.pickup-title{font-size:12px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:5px}
.pickup-addr{font-size:11px;color:var(--text2);line-height:1.5}
.pickup-note{display:flex;align-items:center;gap:5px;background:var(--green-bg);border:1px solid var(--green-bd);border-radius:7px;padding:7px 11px;font-size:11px;color:var(--green);font-weight:500;margin-top:8px}
.pqr{background:var(--bg3);border:1px solid var(--border);border-radius:var(--r-sm);padding:10px;text-align:center;margin-bottom:10px}
.pqr img{width:80px;height:80px;margin:0 auto 5px;border-radius:6px;background:#fff;padding:3px}
.pqr p{font-size:10px;color:var(--text3)}
.pactions{display:flex;flex-direction:column;gap:7px;margin-top:auto;padding-top:12px}
.pdesc{padding:16px 24px;border-top:1px solid var(--border)}
.pdesc h4{font-size:13px;font-weight:600;margin-bottom:5px}
.pdesc p{font-size:13px;color:var(--text2);line-height:1.6}

/* ── CART DRAWER ── */
.cart-ov{position:fixed;inset:0;background:rgba(0,0,0,.38);z-index:300;opacity:0;pointer-events:none;transition:.22s}
.cart-ov.open{opacity:1;pointer-events:all}
.cart-dr{position:fixed;right:0;top:0;bottom:0;width:360px;background:var(--bg2);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:.26s cubic-bezier(.4,0,.2,1)}
.cart-dr.open{transform:translateX(0)}
.cart-hd{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border)}
.cart-hd h3{font-size:15px;font-weight:700}
.cart-x{width:28px;height:28px;border-radius:7px;background:var(--bg3);font-size:13px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);transition:.14s}
.cart-x:hover{background:var(--border)}
.cart-body{flex:1;overflow-y:auto;padding:12px 14px}
.cart-item{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border2)}
.cart-item img{width:58px;height:58px;object-fit:contain;background:#fff;border-radius:8px;padding:3px;flex-shrink:0}
.ci-info{flex:1;min-width:0}
.ci-name{font-size:12px;font-weight:600;line-height:1.3;margin-bottom:1px}
.ci-meta{font-size:10px;color:var(--text3);margin-bottom:6px}
.qty-r{display:flex;align-items:center;gap:5px}
.qty-btn{width:22px;height:22px;border-radius:6px;background:var(--bg3);border:1px solid var(--border);font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text);transition:.13s}
.qty-btn:hover{background:var(--border)}
.qty-n{font-size:12px;font-weight:600;min-width:16px;text-align:center;color:var(--text)}
.ci-price{font-size:13px;font-weight:700;color:var(--text);flex-shrink:0}
.ci-del{color:var(--text3);font-size:13px;cursor:pointer;padding:3px;transition:.13s;margin-top:2px;flex-shrink:0}
.ci-del:hover{color:#e0374b}
.cart-ft{padding:12px 16px;border-top:1px solid var(--border)}
.cart-tr{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.cart-tn{font-size:18px;font-weight:800}
.cart-empty{text-align:center;padding:48px 16px;color:var(--text3)}
.ce-ico{font-size:42px;margin-bottom:10px;opacity:.25}

/* ── BOOKING MODAL ── */
.book-ov{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:500;display:flex;align-items:center;justify-content:center;padding:14px;opacity:0;pointer-events:none;transition:.22s}
.book-ov.open{opacity:1;pointer-events:all}
.book-box{background:var(--bg2);border-radius:18px;width:100%;max-width:480px;max-height:92vh;overflow-y:auto;padding:26px;position:relative}
.book-title{font-size:18px;font-weight:700;margin-bottom:4px}
.book-sub{font-size:13px;color:var(--text2);margin-bottom:20px}
.form-group{margin-bottom:12px}
.form-label{display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px}
.form-input{width:100%;padding:10px 12px;background:var(--bg3);border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:14px;color:var(--text);transition:.16s}
.form-input:focus{border-color:var(--blue);background:var(--bg2);box-shadow:0 0 0 3px rgba(0,113,227,.07)}
textarea.form-input{min-height:72px;resize:vertical}
.cart-summary-box{background:var(--bg3);border-radius:var(--r-sm);padding:11px 13px;font-size:12px;color:var(--text2);margin-bottom:14px}
.success-wrap{text-align:center;padding:12px 0}
.succ-ico{font-size:48px;margin-bottom:12px}
.succ-title{font-size:19px;font-weight:700;margin-bottom:8px}
.succ-sub{color:var(--text2);font-size:14px;line-height:1.6;margin-bottom:18px}
.succ-info{background:var(--bg3);border-radius:var(--r-sm);padding:14px;text-align:left;margin-bottom:14px}
.si-row{display:flex;gap:8px;font-size:13px;margin-bottom:5px}
.si-row:last-child{margin-bottom:0}
.si-l{color:var(--text3);width:110px;flex-shrink:0}
.si-v{color:var(--text);font-weight:500}
.qr-big{background:var(--bg3);border-radius:var(--r-sm);padding:14px;text-align:center;margin-bottom:14px}
.qr-big img{width:120px;height:120px;margin:0 auto 7px;border-radius:8px;background:#fff;padding:4px}
.qr-big p{font-size:12px;color:var(--text2)}

/* ── STORE SECTION ── */
.store-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);overflow:hidden}
.store-map-block{background:linear-gradient(145deg,#ddeeff,#c2d8f0);display:flex;align-items:center;justify-content:center;min-height:230px;position:relative;overflow:hidden;cursor:pointer;transition:.2s}
[data-theme=dark] .store-map-block{background:linear-gradient(145deg,#152234,#0d1a2a)}
.store-map-block:hover{opacity:.9}
.map-grid-overlay{position:absolute;inset:0;background-image:linear-gradient(rgba(0,113,227,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(0,113,227,.07) 1px,transparent 1px);background-size:32px 32px}
.mpin-wrap{position:relative;z-index:1;text-align:center}
.mpin{width:48px;height:48px;background:var(--blue);border-radius:50% 50% 50% 0;transform:rotate(-45deg);margin:0 auto 12px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,113,227,.45)}
.mpin span{transform:rotate(45deg);font-size:18px;display:block}
.mpin-name{font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px}
.mpin-addr{font-size:11px;color:var(--text2);max-width:160px;line-height:1.4;margin-bottom:10px}
.store-info-panel{padding:24px}
.store-info-panel h3{font-size:16px;font-weight:700;margin-bottom:16px}
.sir{display:flex;gap:9px;align-items:flex-start;margin-bottom:12px}
.sir-ico{font-size:15px;flex-shrink:0;margin-top:1px}
.sir-l{font-size:10px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.sir-v{font-size:13px;color:var(--text);font-weight:500;margin-top:2px;line-height:1.4}
.hours-table{width:100%;font-size:12px;margin-top:6px}
.hours-table td{padding:3px 0;color:var(--text2)}
.hours-table td:last-child{text-align:right;color:var(--text);font-weight:500}
.td-closed{color:#d62a1f!important;font-weight:700!important}

/* ── REVIEWS ── */
.rev-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.rev-card{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:16px}
.rev-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.rev-name{font-size:13px;font-weight:600}
.rev-date{font-size:11px;color:var(--text3)}
.rev-stars{font-size:11px;color:#f59e0b;margin-bottom:5px}
.rev-text{font-size:13px;color:var(--text2);line-height:1.55}

/* ── FEEDBACK ── */
.fb-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:32px;align-items:center}
.fb-title{font-size:20px;font-weight:700;margin-bottom:9px}
.fb-sub{color:var(--text2);font-size:13px;line-height:1.65;margin-bottom:16px}
.contact-pills{display:flex;gap:8px;flex-wrap:wrap}
.cpill{display:flex;align-items:center;gap:6px;padding:7px 13px;border:1px solid var(--border);border-radius:100px;font-size:13px;color:var(--text);cursor:pointer;transition:.15s}
.cpill:hover{border-color:var(--blue);background:rgba(0,113,227,.04)}

/* ── PROFILE / ORDERS ── */
.profile-wrap{max-width:720px;margin:0 auto;padding:36px 24px}
.profile-hd{display:flex;align-items:center;gap:14px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:18px;margin-bottom:20px}
.avatar{width:46px;height:46px;border-radius:50%;background:var(--blue);color:#fff;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pname{font-size:16px;font-weight:700}
.pemail{font-size:13px;color:var(--text3)}
.order-card{background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:12px}
.order-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.order-id{font-weight:700;color:var(--blue)}
.status-pill{padding:3px 10px;border-radius:100px;font-size:11px;font-weight:700}

