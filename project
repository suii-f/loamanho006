function doSearch(q){
  const d=$('sdrop');
  if(!q.trim()){ d.classList.remove('open'); return; }
  const res=P.filter(p=>
    p.brand.toLowerCase().includes(q.toLowerCase())||
    p.model.toLowerCase().includes(q.toLowerCase())||
    (p.color&&p.color.toLowerCase().includes(q.toLowerCase()))
  ).slice(0,5);
  if(!res.length){ d.classList.remove('open'); return; }
  d.innerHTML=res.map(p=>`
    <div class="sdrop-item" onclick="openProd(${p.id});document.querySelector('.nav-search input').value='';document.getElementById('sdrop').classList.remove('open')">
      <img src="${p.img}" onerror="this.src='${fallback(p)}'">
      <div><div class="sdrop-name">${p.brand} ${p.model}</div><div class="sdrop-price">${fmt(p.price)}</div></div>
