function applyTheme(){
  document.documentElement.setAttribute('data-theme', S.theme);
  $('theme-pill').textContent = S.theme==='light' ? '🌙 Тёмная' : '☀️ Светлая';
}
function toggleTheme(){
  S.theme = S.theme==='light' ? 'dark' : 'light';
  save('theme', S.theme); applyTheme();
}

