function nav(page){
  S.page = page;
  document.querySelectorAll('.page').forEach(el=>el.classList.remove('active'));
  const pg = $('page-'+page);
  if(pg) pg.classList.add('active');
  document.querySelectorAll('.nl').forEach(el=>el.classList.remove('on'));
  const nl = $('nl-'+page);
  if(nl) nl.classList.add('on');
  window.scrollTo(0,0); closeCart();
  if(page==='home')    renderHome();
  if(page==='catalog') renderCatalog();
  if(page==='profile') renderProfile();
  if(page==='admin')   renderAdmin();
}

// ════════════════════════════════════════════
//  CART
// ════════════════════════════════════════════
function addToCart(id){
  const p=P.find(x=>x.id===id); if(!p) return;
  const ex=S.cart.find(x=>x.id===id);
  if(ex) ex.qty++; else S.cart.push({...p,qty:1});
  save('cart',S.cart); updBadge(); renderCartDrawer();
  toast(`«${p.model}» добавлен в корзину`);
}
function removeFromCart(id){ S.cart=S.cart.filter(x=>x.id!==id); save('cart',S.cart); updBadge(); renderCartDrawer(); }
function changeQty(id,d){
  const i=S.cart.find(x=>x.id===id); if(!i) return;
  i.qty+=d; if(i.qty<1) removeFromCart(id); else { save('cart',S.cart); updBadge(); renderCartDrawer(); }
}
function openCart(){ $('cart-ov').classList.add('open'); $('cart-dr').classList.add('open'); renderCartDrawer(); }
function closeCart(){ $('cart-ov').classList.remove('open'); $('cart-dr').classList.remove('open'); }

function renderCartDrawer(){
  const body=$('cart-body'), ft=$('cart-ft');
  if(!S.cart.length){
    body.innerHTML=`<div class="cart-empty"><div class="ce-ico">🛍</div><p>Корзина пуста</p><p style="font-size:11px;margin-top:4px">Добавьте товары из каталога</p></div>`;
    ft.innerHTML=''; return;
  }
  body.innerHTML=S.cart.map(i=>`
    <div class="cart-item">
      <img src="${i.img}" alt="${i.model}" onerror="this.src='${fallback(i)}'">
      <div class="ci-info">
        <div class="ci-name">${i.brand} ${i.model}</div>
        <div class="ci-meta">${i.color||''}${i.ram>0?' · '+i.ram+'/'+i.storage+' ГБ':''}</div>
        <div class="qty-r">
          <button class="qty-btn" onclick="changeQty(${i.id},-1)">−</button>
          <span class="qty-n">${i.qty}</span>
          <button class="qty-btn" onclick="changeQty(${i.id},1)">+</button>
          <span style="font-size:11px;color:var(--text3);margin-left:4px">${fmt(i.price)}/шт</span>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <div class="ci-price">${fmt(i.price*i.qty)}</div>
        <span class="ci-del" onclick="removeFromCart(${i.id})">✕</span>
      </div>
    </div>`).join('');
  ft.innerHTML=`
    <div class="cart-tr"><span style="font-size:13px;color:var(--text2)">Итого:</span><span class="cart-tn">${fmt(cartTotal())}</span></div>
    <button class="btn btn-primary btn-full" style="border-radius:12px;margin-bottom:8px" onclick="openBook()">🛍 Забронировать товар</button>
    <a href="https://wa.me/${STORE.wa}?text=${encodeURIComponent('Хочу забронировать: '+S.cart.map(i=>i.brand+' '+i.model+' × '+i.qty).join(', '))}"
       target="_blank" class="btn btn-green btn-full" style="border-radius:12px;text-decoration:none">💬 Написать в WhatsApp</a>
    <p style="font-size:11px;color:var(--text3);text-align:center;margin-top:8px">Оплата наличными или переводом в магазине</p>`;
}

